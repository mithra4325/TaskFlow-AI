# ==============================================================================
# TaskFlow AI — Environment Configuration Template
# Copy this file to '.env' for local development:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Windows (CMD):        copy .env.example .env
#   Linux / macOS:        cp .env.example .env
#
# CRITICAL: NEVER COMMIT YOUR ACTUAL '.env' FILE OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# --- Google Gemini AI API ---
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- MongoDB Persistence (Chat logs, feedback ratings) ---
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local fallback example: mongodb://localhost:27017/devhelp_ai
MONGODB_URI=your_mongodb_uri_here

# --- GitHub Integration Token (Optional / Publishing) ---
# Personal Access Token with repo scope for automated releases or GitHub API operations
GITHUB_TOKEN=your_github_token_here

# --- Django Security Settings ---
# In production, generate a secure random key and set DEBUG=False
SECRET_KEY=django-insecure-taskflow-ai-dev-key-change-in-production-!@#$
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app

# --- Production Database (PostgreSQL) ---
# Leave empty or unset to use local SQLite (db.sqlite3).
# In production (Render, Railway, Heroku), provide the PostgreSQL connection URL:
# DATABASE_URL=postgres://user:password@hostname:5432/dbname
DATABASE_URL=

# --- Production Security & HTTPS Settings ---
# Set to True when deploying behind HTTPS in production
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
